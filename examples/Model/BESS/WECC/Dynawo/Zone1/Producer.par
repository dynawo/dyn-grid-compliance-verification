<?xml version='1.0' encoding='UTF-8'?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="Bess">
    <!-- REEC_C -->
    <par type="BOOL" name="BESS_PfFlag" value="false"/>
    <par type="BOOL" name="BESS_VFlag" value="true"/>
    <par type="BOOL" name="BESS_QFlag" value="true"/>
    <par type="BOOL" name="BESS_PQFlag" value="false"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDipPu" value="0.9"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VUpPu" value="1.35"/>
    <par type="DOUBLE" name="BESS_tRv" value="0.01"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_Dbd1Pu" value="-0.05"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_Dbd2Pu" value="0.05"/>
    <par type="DOUBLE" name="BESS_Kqv" value="2"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_Iqh1Pu" value="1.1"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_Iql1Pu" value="-1.1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VRef0Pu" value="1"/>
    <par type="DOUBLE" name="BESS_tpREEC" value="0.05"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_QMaxREECPu" value="0.8"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_QMinREECPu" value="-0.8"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VMaxPu" value="1.1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VMinPu" value="0.9"/>
    <par type="DOUBLE" name="BESS_Kqp" value="1"/>
    <par type="DOUBLE" name="BESS_Kqi" value="0.5"/>
    <par type="DOUBLE" name="BESS_Kvp" value="1"/>
    <par type="DOUBLE" name="BESS_Kvi" value="0.7"/>
    <par type="DOUBLE" name="BESS_tIq" value="0.01"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_DPMaxPu" value="999"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_DPMinPu" value="-999"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_PMaxREECPu" value="1"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_PMinREECPu" value="-1"/>
    <!-- Base unit: Un, SnZone1 -->
    <par type="DOUBLE" name="BESS_IMaxPu" value="1.3"/>
    <par type="DOUBLE" name="BESS_tPord" value="0.01"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIq11" value="1.1"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIq12" value="1.1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIq21" value="1.15"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIq22" value="1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIq31" value="1.16"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIq32" value="1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIq41" value="1.17"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIq42" value="1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIp11" value="1.1"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIp12" value="1.1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIp21" value="1.15"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIp22" value="1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIp31" value="1.16"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIp32" value="1"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_VDLIp41" value="1.17"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_VDLIp42" value="1"/>
    <par type="DOUBLE" name="BESS_tBattery" value="9999"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_SOC0Pu" value="0.75"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_SOCMaxPu" value="0.8"/>
    <!-- Base unit: SnZone1 -->
    <par type="DOUBLE" name="BESS_SOCMinPu" value="0.2"/>
    <!-- REGC_A -->
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_IqrMaxPu" value="20"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_IqrMinPu" value="-20"/>
    <par type="DOUBLE" name="BESS_RrpwrPu" value="10"/>
    <par type="DOUBLE" name="BESS_tFilterGC" value="0.02"/>
    <par type="DOUBLE" name="BESS_tG" value="0.02"/>
    <par type="BOOL" name="BESS_Lvplsw" value="false"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_brkpt" value="0.05"/>
    <!-- Base unit: Un2 -->
    <par type="DOUBLE" name="BESS_zerox" value="0.1"/>
    <!-- Base unit: Un2, SnZone1 -->
    <par type="DOUBLE" name="BESS_lvpl1" value="1.22"/>
    <par type="DOUBLE" name="BESS_KpPLL" value="3"/>
    <par type="DOUBLE" name="BESS_KiPLL" value="20"/>
    <!-- Base unit: wn (= 2*pi*50 rd/s) -->
    <par type="DOUBLE" name="BESS_OmegaMaxPu" value="1.5"/>
    <!-- Base unit: wn (= 2*pi*50 rd/s) -->
    <par type="DOUBLE" name="BESS_OmegaMinPu" value="0.5"/>
    <!-- LV Transformer -->
    <par type="BOOL" name="BESS_ConverterLVControl" value="true"/>
    <par type="DOUBLE" name="BESS_RLvTrPu" value="0.015"/>
    <par type="DOUBLE" name="BESS_XLvTrPu" value="0.06"/>
    <!-- General -->
    <par type="DOUBLE" name="BESS_SNom" value="0.5"/>
  </set>

  <set id="Group_Xfmr">
    <!-- impedances in pu, base SnRef = 100 MVA -->
    <par type="DOUBLE" name="transformer_RPu" value="3.0"/>
    <par type="DOUBLE" name="transformer_XPu" value="12.0"/>
    <par type="DOUBLE" name="transformer_BPu" value="0.0"/>
    <par type="DOUBLE" name="transformer_GPu" value="0.0"/>
    <par type="DOUBLE" name="transformer_rTfoPu" value="1.0"/>
  </set>
</parametersSet>

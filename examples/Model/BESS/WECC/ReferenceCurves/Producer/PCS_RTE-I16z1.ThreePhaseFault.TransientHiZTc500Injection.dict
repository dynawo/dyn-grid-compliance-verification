[Curves-Metadata]
# True when the reference curves are field measurements
is_field_measurements = False
# Instant of time at which the event or fault starts
# Variable sim_t_event_start is called simply sim_t_event in the DTR
sim_t_event_start = 30.0
# Duration of the event or fault
fault_duration = 0.5
# Frequency sampling of the reference curves
frequency_sampling = 15.0
# The maximum injected current of a generator, when the curves come from field measurements:
#    <generator>_GEN_MaxInjectedCurrentPu =

[Curves-Dictionary]
# To represent a signal that is in raw abc three-phase form, the affected signal must be
# tripled and the suffixes _a, _b and _c must be added as in the following example:
#    SignalName_a =
#    SignalName_b =
#    SignalName_c =
time = time
InternalNode1_BUS_Voltage = InternalNode1_BUS_Voltage
Bess_GEN_VoltageInjTerminal = Bess_GEN_VoltageInjTerminal
Bess_GEN_ActivePowerControlledPu = Bess_GEN_ActivePowerControlledPu
Bess_GEN_ReactivePowerControlledPu = Bess_GEN_ReactivePowerControlledPu
Bess_GEN_ActiveCurrentInjTerminal = Bess_GEN_ActiveCurrentInjTerminal
Bess_GEN_ReactiveCurrentInjTerminal = Bess_GEN_ReactiveCurrentInjTerminal

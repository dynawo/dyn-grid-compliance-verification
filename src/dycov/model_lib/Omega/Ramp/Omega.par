<?xml version="1.0" encoding="UTF-8"?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="OmegaRef">
    <par type="DOUBLE" name="ramp_duration" value="{{event_duration}}"/>
    <par type="DOUBLE" name="ramp_height" value="{{event_step_value}}"/>
    <par type="DOUBLE" name="ramp_offset" value="1"/>
    <par type="DOUBLE" name="ramp_startTime" value="{{event_start}}"/>
  </set>
</parametersSet>
